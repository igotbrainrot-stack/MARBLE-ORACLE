+def chart_grid_plan(requested, visible, width, height):
+    """Pure viewport layout model, independent of provider results or Tk.
+
+    CHARTS selects a maximum number of sourced charts, rather than the number
+    of fixed source slots. One graph can occupy the full viewport; dense modes
+    scroll only when a legible minimum card height cannot fit.
+    """
+    if requested not in (1, 2, 4, 6, 9):
+        raise ValueError('Unsupported chart count')
+    visible = max(0, min(requested, int(visible)))
+    width = max(1, int(width))
+    height = max(1, int(height))
+    columns = 2 if width >= 900 and visible >= 2 else 1
+    rows = (visible + columns - 1) // columns if visible else 0
+    card_min = 325 if columns == 2 else 340
+    # A single chart uses the viewport, not the old rigid 405px row height.
+    row_height = max(card_min, (height - 12) // max(1, rows)) if visible else 0
+    content_height = max(height, rows * (row_height + 16) + 8) if visible else height
+    return columns, rows, row_height, content_height
 
 
